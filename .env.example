BINANCE_API_KEY=your_binance_testnet_api_key
BINANCE_API_SECRET=your_binance_testnet_api_secret
SYMBOL=BTC/USDT
TIMEFRAME=1h

# --- AI provider (ai_strategy.py) -----------------------------------------
# "ollama" (default): local/self-hosted, no API key. Install Ollama, run
# `ollama pull llama3.1`, then `ollama serve` before starting the bot.
# "groq": Groq's hosted free-tier API instead -- set AI_PROVIDER=groq and
# GROQ_API_KEY below.
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# GROQ_API_KEY=your_groq_api_key
